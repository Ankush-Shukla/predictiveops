--- /dev/null
+++ b/tests/integration/test_api_history.py
@@ -0,0 +1,52 @@
+import httpx
+from fastapi.testclient import TestClient
+
+from app.api.main import create_app
+from app.api.routers import history
+from app.core.config import Settings
+
+
+def _client(monkeypatch, handler):
+    monkeypatch.setattr(
+        history, "prometheus_client",
+        lambda base_url: httpx.AsyncClient(base_url="http://prom", transport=httpx.MockTransport(handler)))
+    return TestClient(create_app(Settings(_env_file=None, log_level="WARNING"), None, load_model=False))
+
+
+def test_host_history_returns_aligned_real_points(monkeypatch):
+    def handler(request):
+        return httpx.Response(200, json={"status": "success", "data": {"result": [
+            {"values": [[1000, "10"], [1015, "20"]]}]}})
+    with _client(monkeypatch, handler) as c:
+        body = c.get("/v1/host/history?minutes=15").json()
+    assert body["available"] is True
+    assert len(body["points"]) == 2
+    assert body["latest"]["cpu_pct"] == 20.0
+
+
+def test_host_history_degrades_when_prometheus_is_down(monkeypatch):
+    def handler(request):
+        raise httpx.ConnectError("down")
+    with _client(monkeypatch, handler) as c:
+        body = c.get("/v1/host/history").json()
+    assert body["available"] is False and body["points"] == [] and body["error"]
+
+
+def test_host_history_validates_window(monkeypatch):
+    with _client(monkeypatch, lambda r: httpx.Response(200, json={})) as c:
+        assert c.get("/v1/host/history?minutes=1").status_code == 422
+
+
+def test_infra_alerts_and_coverage(monkeypatch):
+    def handler(request):
+        if request.url.path == "/api/v1/alerts":
+            return httpx.Response(200, json={"status": "success", "data": {"alerts": [
+                {"labels": {"alertname": "HostCpuWarning", "severity": "warning"}, "state": "firing",
+                 "annotations": {"summary": "cpu"}}]}})
+        return httpx.Response(200, json={"status": "success", "data": {"result": [
+            {"values": [[3600, "1"], [7200, "1"]]}]}})
+    with _client(monkeypatch, handler) as c:
+        alerts = c.get("/v1/infra/alerts").json()
+        cov = c.get("/v1/telemetry/coverage").json()
+    assert alerts["firing"] == 1 and alerts["alerts"][0]["name"] == "HostCpuWarning"
+    assert cov["available"] is True and cov["covered_hours"] == 2.0
diff --git a/tests/unit/test_build_training_data.py b/tests/unit/test_build_training_data.py
new file mode 100644
index 0000000..94e4d1d
--- /dev/null
+++ b/tests/unit/test_build_training_data.py
@@ -0,0 +1,52 @@
+import sqlite3
+
+import pytest
+
+from scripts import build_training_data as btd
+
+
+def _db_with(samples, incidents):
+    db = sqlite3.connect(":memory:")
+    db.execute("""CREATE TABLE telemetry_samples (scope TEXT, series_id TEXT, timestamp TEXT,
+        cpu_pct REAL, memory_pct REAL, disk_io_util_pct REAL, network_rx_mbps REAL, network_tx_mbps REAL,
+        request_rate_rps REAL, latency_p95_ms REAL, error_rate REAL, ingestion_source TEXT)""")
+    db.execute("""CREATE TABLE incidents (series_id TEXT, started_at TEXT, ended_at TEXT, status TEXT)""")
+    db.executemany("INSERT INTO telemetry_samples VALUES (?,?,?,?,?,?,?,?,?,?,?,?)", samples)
+    db.executemany("INSERT INTO incidents VALUES (?,?,?,?)", incidents)
+    return db
+
+
+def _row(series, minute):
+    return ("host", series, f"2026-01-01T00:{minute:02d}:00+00:00", 1, 2, 3, 4, 5, 0, 0, 0, "t")
+
+
+def test_only_confirmed_incident_windows_are_labelled():
+    samples = [_row("h", m) for m in range(10)] + [_row("other", m) for m in range(10)]
+    incidents = [("h", "2026-01-01T00:03:00+00:00", "2026-01-01T00:05:00+00:00", "confirmed"),
+                 ("h", "2026-01-01T00:08:00+00:00", "2026-01-01T00:09:00+00:00", "retracted")]
+    db = _db_with(samples, incidents)
+    telemetry = btd.load_telemetry(db, "host", None)
+    labels = btd.label_unhealthy(telemetry, btd.load_incidents(db))
+    flagged = telemetry[labels]
+    assert list(flagged["series_id"].unique()) == ["h"]
+    assert [t.minute for t in flagged["timestamp"]] == [3, 4]
+
+
+def test_no_incidents_means_no_positive_labels():
+    db = _db_with([_row("h", m) for m in range(5)], [])
+    telemetry = btd.load_telemetry(db, "host", None)
+    assert not btd.label_unhealthy(telemetry, btd.load_incidents(db)).any()
+
+
+def test_refuses_to_write_without_enough_incidents(tmp_path):
+    path = tmp_path / "p.sqlite"
+    db = sqlite3.connect(path)
+    db.execute("""CREATE TABLE telemetry_samples (scope TEXT, series_id TEXT, timestamp TEXT,
+        cpu_pct REAL, memory_pct REAL, disk_io_util_pct REAL, network_rx_mbps REAL, network_tx_mbps REAL,
+        request_rate_rps REAL, latency_p95_ms REAL, error_rate REAL, ingestion_source TEXT)""")
+    db.execute("INSERT INTO telemetry_samples VALUES (?,?,?,?,?,?,?,?,?,?,?,?)", _row("h", 0))
+    db.commit(); db.close()
+    out = tmp_path / "host.csv.gz"
+    with pytest.raises(SystemExit):
+        btd.main(["--scope", "host", "--db", str(path), "--out", str(out)])
+    assert not out.exists()
diff --git a/tests/unit/test_host_history.py b/tests/unit/test_host_history.py
new file mode 100644
index 0000000..f87dda8
--- /dev/null
+++ b/tests/unit/test_host_history.py
@@ -0,0 +1,54 @@
+import pytest
+
+from app.services import host_history as h
+
+
+def _matrix(values):
+    return {"status": "success", "data": {"result": [{"values": values}]}}
+
+
+def test_pick_step_caps_points():
+    for minutes in (5, 15, 60, 360, 1440):
+        step = h.pick_step(minutes)
+        assert step >= h.MIN_STEP_SECONDS
+        assert minutes * 60 / step <= h.MAX_POINTS
+
+
+def test_matrix_to_map_drops_non_finite_and_keeps_floats():
+    assert h.matrix_to_map(_matrix([[1, "1.5"], [2, "NaN"], [3, "2"]])) == {1.0: 1.5, 3.0: 2.0}
+
+
+def test_matrix_to_map_rejects_errors_and_ambiguity():
+    with pytest.raises(ValueError):
+        h.matrix_to_map({"status": "error", "error": "boom"})
+    with pytest.raises(ValueError):
+        h.matrix_to_map({"status": "success", "data": {"result": [{}, {}]}})
+
+
+def test_empty_result_is_empty_map_not_zeros():
+    assert h.matrix_to_map({"status": "success", "data": {"result": []}}) == {}
+
+
+def test_merge_keeps_missing_values_missing():
+    points = h.merge_points({"a": {1: 1, 2: 2}, "b": {2: 5, 3: 6}})
+    assert points[0] == {"t": 1, "a": 1, "b": None}
+    assert points[2] == {"t": 3, "a": None, "b": 6}
+    assert h.latest_values(points, ["a", "b"]) == {"a": 2, "b": 6}
+
+
+def test_coverage_counts_only_up_buckets():
+    cov = h.summarize_coverage(_matrix([[3600, "1"], [7200, "0"], [10800, "1"]]), 3600)
+    assert cov == {"first_sample": 3600.0, "last_sample": 10800.0, "covered_hours": 2.0}
+
+
+def test_alerts_sorted_firing_first():
+    payload = {"status": "success", "data": {"alerts": [
+        {"labels": {"alertname": "B", "severity": "warning"}, "state": "pending", "annotations": {}},
+        {"labels": {"alertname": "A"}, "state": "firing", "annotations": {"summary": "s"}},
+    ]}}
+    assert [a["name"] for a in h.parse_alerts(payload)] == ["A", "B"]
+
+
+def test_history_queries_include_all_host_model_inputs():
+    from app.core.domain import HOST_METRIC_COLUMNS
+    assert set(HOST_METRIC_COLUMNS) <= set(h.HOST_HISTORY_QUERIES)
