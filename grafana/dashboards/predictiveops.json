    {
      "id": 9,
      "title": "Container inventory · one row per container",
      "type": "table",
      "description": "Each container appears once in this inventory. CPU is in cores; memory is working set; network is bytes per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{image!=\"\",name!=\"\"}[5m]))",
          "legendFormat": "CPU cores",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (name) (container_memory_working_set_bytes{image!=\"\",name!=\"\"})",
          "legendFormat": "Memory working set",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{image!=\"\",name!=\"\"}[5m]))",
          "legendFormat": "Network RX",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "sum by (name) (rate(container_network_transmit_bytes_total{image!=\"\",name!=\"\"}[5m]))",
          "legendFormat": "Network TX",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "name",
            "mode": "outerTabular"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "CPU cores",
              "Value #B": "Memory working set",
              "Value #C": "Network RX",
              "Value #D": "Network TX"
            }
          }
        }
      ]
    },
