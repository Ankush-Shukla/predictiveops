# Copy to .env. Never commit real secrets. All variables use the PREDICTIVEOPS_ prefix.
PREDICTIVEOPS_ENV=development  # Compose API overrides this to production
PREDICTIVEOPS_LOG_LEVEL=INFO
PREDICTIVEOPS_LOG_JSON=true
PREDICTIVEOPS_DATA_DIR=data/generated
PREDICTIVEOPS_SQLITE_PATH=data/generated/predictiveops.sqlite
PREDICTIVEOPS_PROMETHEUS_URL=http://localhost:9090
PREDICTIVEOPS_MLFLOW_TRACKING_URI=sqlite:///artifacts/mlflow.db
PREDICTIVEOPS_MODEL_DIR=artifacts/models
PREDICTIVEOPS_GATE_MIN_F1=0.70
PREDICTIVEOPS_GATE_MAX_FPR=0.05
PREDICTIVEOPS_HORIZON_MINUTES=20
PREDICTIVEOPS_SYNTHETIC_SEED=42
# Safety: remediation is dry-run unless explicitly disabled
PREDICTIVEOPS_DRY_RUN=true
PREDICTIVEOPS_REMEDIATION_COOLDOWN_SECONDS=900
PREDICTIVEOPS_MAX_ACTIONS_PER_HOUR=4
# Optional: require X-API-Key on write endpoints (set via env / secret store, never commit)
# PREDICTIVEOPS_API_KEY=
PREDICTIVEOPS_INGEST_BUFFER_MINUTES=360
# Alert policy
PREDICTIVEOPS_POLICY_SUSTAIN_ALERT=3
PREDICTIVEOPS_POLICY_SUSTAIN_REMEDIATE=5
PREDICTIVEOPS_POLICY_REMEDIATE_THRESHOLD=0.80
# Remediation master switch (OFF by default). Even when enabled, DRY_RUN=true executes nothing.
PREDICTIVEOPS_REMEDIATION_ENABLED=false
# Explicit series -> container/action map (JSON). Keep empty until an action has been reviewed.
# PREDICTIVEOPS_REMEDIATION_TARGETS={}
# Optional live Prometheus polling. Compose enables it and uses independent host/application scopes.
PREDICTIVEOPS_PROMETHEUS_ENABLED=false
PREDICTIVEOPS_PROMETHEUS_HOST_SERIES_ID=home-server
PREDICTIVEOPS_PROMETHEUS_APPLICATION_SERVICES=
PREDICTIVEOPS_PROMETHEUS_STEP_SECONDS=60
PREDICTIVEOPS_PROMETHEUS_POLL_SECONDS=60
# Development-only legacy combined-model polling; do not use in production.
# PREDICTIVEOPS_PROMETHEUS_SERVICES=
# Docker Compose: set this to the server's Tailscale IPv4 address (e.g. 100.x.y.z).
# Frontend, Grafana and Node Exporter bind only to this interface, not public LAN interfaces.
TAILSCALE_IP=
# Docker Compose: REQUIRED. Generate with: openssl rand -hex 32. Never commit the generated value.
GRAFANA_ADMIN_PASSWORD=
PREDICTIVEOPS_LOAD_GENERATOR_TOKEN=
# Optional for compose: PREDICTIVEOPS_API_KEY (protects write endpoints)

# Group ID owning /var/run/docker.sock on the Docker host (stat -c '%g' /var/run/docker.sock)
DOCKER_GID=999
